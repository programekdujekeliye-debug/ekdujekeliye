# Backend Configuration Example
PORT=5001
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ekdujekeliye?retryWrites=true&w=majority

# Administrative Passwords
ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta WhatsApp Configuration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# System Cron & Background Worker Secrets
CRON_SECRET=
ARCHIVE_WORKER_SECRET=
BACKUP_WORKER_SECRET=
GOOGLE_MEDIA_VIEW_SECRET=
APPS_SCRIPT_VIEWER_URL=
CLOUDINARY_CLEANUP_ENABLED=false
ENABLE_BACKEND_BACKUP_CRON=false

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://ekdujekeliye.com,https://www.ekdujekeliye.com

# Cloudflare R2 Standard Storage (S3-Compatible Active Media Tier)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=edkl-public-media
R2_PRIVATE_BUCKET=edkl-private-media
R2_PUBLIC_BASE_URL=https://media.ekdujekeliye.in
R2_ENABLED=true
